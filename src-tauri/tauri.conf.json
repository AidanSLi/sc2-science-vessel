{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sc2-science-vessel",
  "version": "0.0.0",
  "identifier": "dev.aidansli.sc2-science-vessel",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sc2-science-vessel",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "maxWidth": 7680,
        "maxHeight": 4320,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "Offline SC2 replay analysis and build-order coach",
    "longDescription": "Analyse StarCraft II replays locally — worker, economy, production and battle metrics — and follow a preset build order on the in-game clock inside a game overlay. Requires no account and no network.",
    "externalBin": [
      "sc2sv-sidecar"
    ]
  }
}
