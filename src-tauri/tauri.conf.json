{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SC2 Science Vessel",
  "version": "0.1.0-beta.1",
  "identifier": "dev.aidansli.sc2-science-vessel",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SC2 Science Vessel",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "maxWidth": 7680,
        "maxHeight": 4320,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/64x64.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Offline SC2 replay analysis, build orders and an in-game overlay",
    "longDescription": "Analyse StarCraft II replays locally — worker, economy, production and battle metrics — and follow a preset build order on the game's own clock in a transparent overlay. No account and no network required for replay analysis.",
    "externalBin": [
      "sc2sv-sidecar",
      "sc2sv-watch"
    ]
  }
}
